    {
      "id": "G3JLzqaBaccjfNmykBXp1",
      "type": "text",
      "x": 823.2740333193826,
      "y": -29.235620514959265,
      "width": 828.679443359375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aDV",
